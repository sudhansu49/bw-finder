generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  password        String
  company         String?
  role            String   @default("user")
  avatar          String?
  credits         Int      @default(0)
  planId          String?
  stripeCustomerId String?
  status          String   @default("active") // active, suspended, banned
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan               Plan?    @relation(fields: [planId], references: [id])
  leads              Lead[]
  outreach           Outreach[]
  searchJobs         SearchJob[]
  leadNotes          LeadNote[]
  leadTasks          LeadTask[]
  reminders          Reminder[]
  activities         ActivityLog[]
  creditTransactions CreditTransaction[]
  subscriptions      Subscription[]
}

model Business {
  id                      String   @id @default(cuid())
  name                    String
  category                String
  address                 String?
  city                    String?
  state                   String?
  country                 String?
  phone                   String?
  email                   String?
  website                 String?
  hasWebsite              Boolean  @default(false)
  websiteStatus           String?  // NO_WEBSITE, HAS_WEBSITE, SOCIAL_ONLY
  googleRating            Float?
  googleReviews           Int?
  reviewCount             Int?
  facebookUrl             String?
  instagramUrl            String?
  linkedinUrl             String?
  socialPresence          Int      @default(0) // count of social media platforms
  leadScore               Int?     // 0-100
  opportunityScore        Int?     // 0-100
  estimatedMonthlyRevenue Float?   // estimated monthly revenue in USD
  scoreFactors            String?  // JSON string with scoring breakdown
  auditReport             String?  // JSON string with full audit report
  auditScore              Int?     // 0-100 overall audit score
  auditDate               DateTime? // when audit was last run
  proposalData            String?  // JSON string with proposal packages
  proposalDate            DateTime? // when proposal was last generated
  latitude                Float?
  longitude               Float?
  source                  String   @default("web_search")
  sourceDetail            String?  // Specific directory or listing source
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  leads    Lead[]
}

model Lead {
  id              String    @id @default(cuid())
  businessId      String
  userId          String
  status          String    @default("new_lead") // new_lead, contacted, interested, meeting_scheduled, proposal_sent, won, lost
  priority        String    @default("medium") // low, medium, high, urgent
  estimatedValue  Float?
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business   Business      @relation(fields: [businessId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
  outreach   Outreach[]
  leadNotes  LeadNote[]
  leadTasks  LeadTask[]
  reminders  Reminder[]
  activities ActivityLog[]
}

model Outreach {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  type      String   @default("email")
  subject   String?
  notes     String?
  outcome   String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model LeadTask {
  id          String    @id @default(cuid())
  leadId      String
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Reminder {
  id          String   @id @default(cuid())
  leadId      String
  userId      String
  title       String
  description String?
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  action    String   // created, status_change, note_added, task_added, task_completed, reminder_added, etc.
  details   String?  // JSON string with additional details
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  basePrice   Float
  features    String
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SearchJob {
  id           String    @id @default(cuid())
  userId       String
  query        String
  location     String
  category     String?
  country      String?
  state        String?
  city         String?
  status       String    @default("pending")
  resultsCount Int       @default(0)
  sources      String?   // JSON array of sources used
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  price       Float     // monthly price in USD
  credits     Int       // credits included per month
  features    String    // JSON array of feature strings
  popular     Boolean  @default(false)
  maxLeads    Int      @default(100)
  maxSearches Int      @default(50)
  maxExports  Int      @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  subscriptions Subscription[]
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  planId            String
  status            String   @default("active") // active, canceled, expired, past_due
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // positive = credit added, negative = credit used
  balance     Int      // balance after transaction
  type        String   // purchase, usage, bonus, refund, plan_credits
  description String
  referenceId String?  // ID of the related entity (lead, search, export, etc.)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
