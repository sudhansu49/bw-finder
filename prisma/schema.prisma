generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  company   String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads      Lead[]
  outreach   Outreach[]
  searchJobs SearchJob[]
}

model Business {
  id             String   @id @default(cuid())
  name           String
  category       String
  address        String?
  city           String?
  state          String?
  country        String?
  phone          String?
  email          String?
  website        String?
  hasWebsite     Boolean  @default(false)
  googleRating   Float?
  googleReviews  Int?
  reviewCount    Int?
  facebookUrl    String?
  instagramUrl   String?
  linkedinUrl    String?
  latitude       Float?
  longitude      Float?
  source         String   @default("web_search")
  sourceDetail   String?  // Specific directory or listing source
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads    Lead[]
}

model Lead {
  id              String    @id @default(cuid())
  businessId      String
  userId          String
  status          String    @default("new")
  priority        String    @default("medium")
  estimatedValue  Float?
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  outreach  Outreach[]
}

model Outreach {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  type      String   @default("email")
  subject   String?
  notes     String?
  outcome   String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  basePrice   Float
  features    String
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SearchJob {
  id           String    @id @default(cuid())
  userId       String
  query        String
  location     String
  category     String?
  country      String?
  state        String?
  city         String?
  status       String    @default("pending")
  resultsCount Int       @default(0)
  sources      String?   // JSON array of sources used
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id])
}
